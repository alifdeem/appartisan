###############################################################################
# ArtisanGH — environment
#
#   cp .env.example .env.local
#
# Only the SUPABASE block and NEXT_PUBLIC_APP_URL are needed to run Phase 0.
# Everything below the "SIMULATION" line stays exactly as it is until the
# client's business is registered and we go live. See PLAN.md §3.
###############################################################################


# =============================================================================
# 1. SUPABASE  —  REQUIRED. These are the four values to paste.
# =============================================================================
# Supabase dashboard → Project Settings → Data API  (and → API Keys)
#
# Newer dashboards renamed these:
#   anon / public key   → "publishable key"
#   service_role key    → "secret key"
# Either name is the same value; the variable names below do not change.

# https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Safe to expose to the browser. RLS is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses row level security entirely. Server-side only — never
# prefix it with NEXT_PUBLIC_, never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Needed only by `npm run db:push` / `db:types` via the Supabase CLI.
# Dashboard → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=


# =============================================================================
# 2. APP
# =============================================================================
# Must be the real deployed origin in production — the mock payment provider
# POSTs its webhook to this URL, and Paystack will too at go-live.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# =============================================================================
# 3. SIMULATION  —  leave as-is until go-live
# =============================================================================
# Every paid integration sits behind an adapter. `mock` costs nothing and runs
# the same code paths, including a real HMAC-signed webhook round trip.

PAYMENT_PROVIDER=mock          # mock | live   (live = Paystack)
SMS_PROVIDER=mock              # mock | live   (live = Arkesel)
MAP_PROVIDER=osm               # osm  | google (osm = free OpenStreetMap/Nominatim)

# Mirrors MAP_PROVIDER for the browser-side Leaflet setup.
NEXT_PUBLIC_MAP_PROVIDER=osm

# The fixed login code while SMS_PROVIDER=mock. Shown on the verify screen so
# the client can demo signup without an SMS bill. Ignored entirely in live mode,
# where a real random code is generated.
DEV_OTP_CODE=000000

# Dev role switcher + the OTP hint banner. Forced off in production regardless.
ENABLE_DEV_TOOLS=true
NEXT_PUBLIC_DEV_TOOLS=true

# THE GUARDRAIL.
# The app REFUSES TO BOOT if PAYMENT_PROVIDER or SMS_PROVIDER is "mock" while
# NODE_ENV=production, because that state means jobs complete, invoices
# generate, artisans expect payouts — and no money ever moved.
#
# Set this to true ONLY for the pre-launch demo deployment, while the business
# is still being registered. Delete it the day Paystack goes live.
ALLOW_MOCK_IN_PROD=false


# =============================================================================
# 4. LIVE CREDENTIALS  —  all blank until go-live
# =============================================================================

# --- Paystack ----------------------------------------------------------------
# Required once PAYMENT_PROVIDER=live. Needs the registered business name, a
# certificate of incorporation and a corporate bank account.
# NOTE: we use charge-to-platform + the Transfer API, NOT split payments /
# subaccounts. See PLAN.md §4 for why that is not negotiable.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Paystack dashboard → Settings → API Keys & Webhooks.
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/payments
PAYSTACK_WEBHOOK_SECRET=

# --- Arkesel (SMS) -----------------------------------------------------------
# Required once SMS_PROVIDER=live. Sender ID must be registered with Arkesel
# first — unregistered sender IDs are silently dropped by the networks.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=ArtisanGH

# --- Google Maps -------------------------------------------------------------
# Required once MAP_PROVIDER=google.
# BEFORE putting this key anywhere public: set a hard spend cap on the Google
# Cloud project and restrict the key by HTTP referrer. An unrestricted Maps key
# is one of the easiest ways to get a surprise four-figure bill.
# --- Error monitoring -------------------------------------------------------
# `console` writes one structured JSON line per event to stdout, which Vercel
# captures. That is not aggregation — the same exception thrown four hundred
# times should be one entry with a count — so switch to `sentry` at go-live.
MONITORING_PROVIDER=console
# Required when MONITORING_PROVIDER=sentry. The app posts to Sentry's HTTP
# store endpoint rather than bundling @sentry/nextjs, which would ship ~40KB to
# a phone on 3G for something whose job here is server-side aggregation.
SENTRY_DSN=

GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# Offer sweep (Phase 3)
# -----------------------------------------------------------------------------
# Every 30 seconds something has to retire offers nobody answered and push those
# jobs on to the next artisan, or a job sits in `offer_sent` with nobody looking
# at it while the client watches a spinner.
#
# Migration 0011 schedules this with pg_cron where the extension is available.
# Where it is not, `/api/cron/matching` runs the identical SQL and any scheduler
# can drive it — vercel.json already declares the cron entry.
#
# Required in production: the endpoint advances every stalled job in the system,
# so it refuses to run unauthenticated when NODE_ENV=production. Generate one
# with: openssl rand -hex 32
CRON_SECRET=
